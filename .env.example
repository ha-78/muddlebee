# Muddlebee — environment settings
#
# Copy this file to .env and fill in the blanks (see README.md, "Local setup").
# The defaults below match the local Docker setup (Laravel Sail + MySQL).
# Never commit .env: it holds the app key and passwords.

# --- App ------------------------------------------------------------------

APP_NAME=Muddlebee
# local while developing, production on the server
APP_ENV=local
# Generated by `./sail artisan key:generate`. Keep it secret, and keep it stable:
# changing it logs everyone out and breaks encrypted values.
APP_KEY=
# true locally, ALWAYS false in production
APP_DEBUG=true
# The address you open in the browser, including the port (same as APP_PORT below).
APP_URL=http://localhost:8000

# Interface language: sv (Swedish) or en (English).
APP_LOCALE=sv
APP_FALLBACK_LOCALE=en
# Language of fake names and texts in tests and factories.
APP_FAKER_LOCALE=sv_SE

APP_MAINTENANCE_DRIVER=file

# Seasonal decorations, on for the whole site: christmas, or empty for none.
# Colors and the light/dark theme stay the same; it only adds decorations.
APP_SEASON=

# --- Local Docker ports (Sail) ----------------------------------------------
# Change these if the ports are already taken by another project on your machine.

# The app in the browser: http://localhost:APP_PORT
APP_PORT=8000
# MySQL from your machine (e.g. TablePlus): 127.0.0.1:FORWARD_DB_PORT
FORWARD_DB_PORT=3306
# Vite dev server (`npm run dev`)
VITE_PORT=5174

# --- Database ---------------------------------------------------------------
# With Sail, DB_HOST is the name of the MySQL service in compose.yaml.
# The database and user are created by the MySQL container on its first start,
# together with a separate `testing` database used by the tests.

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=muddlebee
DB_USERNAME=sail
DB_PASSWORD=password

# --- Sessions and remembered devices ----------------------------------------

SESSION_DRIVER=database
# Minutes a session lasts without a remembered device
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only cookies)
# SESSION_SECURE_COOKIE=true

# How many days a signed-in device stays remembered, and the name of its cookie.
DEVICE_REMEMBER_DAYS=7
DEVICE_REMEMBER_COOKIE=muddlebee_device

# --- Cache, queue, files ----------------------------------------------------

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Mail -------------------------------------------------------------------
# The app doesn't send mail yet (password reset links are created by admins).
# `log` writes any mail to storage/logs/laravel.log instead of sending it.

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Logging ----------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug locally, warning or error in production
LOG_LEVEL=debug

# --- Other ------------------------------------------------------------------

# Lower is faster (tests use 4); 12 is a good value for real passwords.
BCRYPT_ROUNDS=12

VITE_APP_NAME="${APP_NAME}"
